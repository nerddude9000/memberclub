<html>
<head>
    <title>Membership Club</title>
		<%- include("components/meta.ejs") %>
</head>
<body>
		<%- include("components/header.ejs") %>
		<main>
			<% if (locals.user) {%>
				<h1>WELCOME BACK <%= user.firstname %> <%= user.lastname %></h1>
				<% if (user.membership === "member") { %>
					<p><i>You have club membership!</i></p>
				<% } %>
			<% } else { %>
				<h1>Please login to access club features.</h1>
			<% } %>
		</main>
</body>
</html>

