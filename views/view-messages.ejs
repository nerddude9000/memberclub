<html>
<head>
    <title>Membership Club</title>
		<%- include("components/meta.ejs") %>
</head>
<body>
		<%- include("components/header.ejs") %>
		<main>
			<h1>Club posts</h1>
			<% if (locals.user) { %>
				<a href="/messages/create">Create a post</a>
			<% } %>

			<div id="messages">
			<% messages.forEach((message) => { %>
				<article class="message-card">
					<h2><%= message.title %></h2>
					<p><%= message.content %></h2>
					<div class="message-meta">
						<% if(message.firstname && message.lastname) { %>
							<p>Written by <i><%= message.firstname %> <%= message.lastname %></i></p>
						<% } else { %>
							<p>Written by <b>[REDACTED]</b></p>
						<% } %>

						<% if(message.created_at) { %>
							<p><%= message.created_at %></p>
						<% } %>
					</div>
				</article>
			<% }) %>
			</div>
		</main>
</body>
</html>

