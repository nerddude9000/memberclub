<!DOCTYPE html>
<html>
<head>
    <title>Membership Club</title>
		<%- include("components/meta.ejs") %>
</head>
<body>
		<%- include("components/header.ejs") %>
		<main>
			<h1>Club posts</h1>
			<% if (locals.user) { %>
				<a href="/posts/create">Create a post</a>
			<% } %>

			<div id="messages">
			<% messages.forEach((message) => { %>
				<article class="message-card">
					<h2><%= message.title %></h2>
					<p><%= message.content %></p>
					<div class="message-meta">
						<% if(message.firstname && message.lastname) { %>
							<p>Written by <i><%= message.firstname %> <%= message.lastname %></i></p>
						<% } else { %>
							<p>Written by <b>[REDACTED]</b></p>
						<% } %>

						<% if(message.created_at) { %>
							<p><%= message.created_at %></p>
						<% } %>
					</div>

					<% if (locals.user && locals.user.membership === "admin") { %>
						<form method="POST" action="/posts/delete/<%= message.id %>" class="delete-message" >
							<button type="submit" onclick="return confirm('Are you sure you want to delete this post? this can\'t be undone.');">
								Delete
							</button>
						</form>
					<% } %>
				</article>
			<% }) %>
			</div>
		</main>
</body>
</html>

